# Ders Zeka — ortam değişkenleri şablonu. `.env.local` olarak kopyala ve doldur.

NEXT_PUBLIC_SITE_URL=https://derszeka.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI sağlayıcıları (opsiyonel — admin panelinden de girilebilir)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# E-posta (opsiyonel — admin panelinden de girilebilir)
RESEND_API_KEY=

# Uygulama sırları — `openssl rand -hex 32` ile üret
ENCRYPTION_KEY=
WORKER_SECRET=
